# Ophamin agentic layer — all-Ollama model routing
# =================================================
# Verified end-to-end on 2026-05-23 by running every tier's agent on real
# inputs (not a leaderboard). Activate with:
#
#     source examples/local_routing.env        # or add to ~/.zshrc
#
# Why all-Ollama: Ollama is Ophamin's default runtime
# (http://localhost:11434/v1) and gives native json_object enforcement +
# automatic context sizing. That sidesteps the LM Studio gotchas observed
# this session — json_object rejected with HTTP 400, and per-load 4096-token
# context that 400s on proof-embedding agents — and, being a single endpoint,
# makes the per-tier base_url limitation moot.
#
# Pull the models once:
#     ollama pull gemma3:27b
#     ollama pull qwen3-coder:30b
#
# Grounded selection (each chosen by observing the actual agent output):
#   gemma3:27b      best all-rounder — clean structured JSON (tool-scout, good
#                   tool relevance) AND large analytical prompts (confound-
#                   enumerator parsed a 6k-token proof and surfaced the real
#                   "batch-accumulation / ordinal" permanence artifact).
#   qwen3-coder:30b richer, more idiomatic code than gemma on adapter-gen
#                   (category filter, fuller docstrings) — the coder edge.

# --- general + analytical tiers -> gemma3:27b ---
export OPHAMIN_LLM_MODEL_FAST="gemma3:27b"
export OPHAMIN_LLM_MODEL_WORKHORSE="gemma3:27b"
export OPHAMIN_LLM_MODEL_REASONING="gemma3:27b"
export OPHAMIN_LLM_MODEL_SCIENTIFIC="gemma3:27b"

# --- code tiers -> qwen3-coder:30b ---
export OPHAMIN_LLM_MODEL_CODER="qwen3-coder:30b"
export OPHAMIN_LLM_MODEL_ENGINEERING="qwen3-coder:30b"

# Notes
# -----
# * SCIENTIFIC currently == REASONING (both gemma3:27b), so Ophamin's capability
#   surface will honestly report it as "general-fallback", not a truly dedicated
#   science model. To make it dedicated, point it at a distinct science-tuned
#   model once you have one (and prefer a NON-reasoning / JSON-capable model —
#   reasoning/"thinking" models ramble past the JSON on structured-output agents).
# * Faster, lower-quality option for the trivial FAST tier (NL->JSON routing):
#       export OPHAMIN_LLM_MODEL_FAST="llama3.1:8b"
