{
  "name": "@ophamin/proof",
  "version": "0.21.2",
  "description": "Read-only verifier for Ophamin signed empirical-proof records. Byte-equivalent to the Python reference canonical form per SCHEMAS.md §Canonical-form determinism (normative).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./canonical": {
      "import": "./dist/canonical.js",
      "types": "./dist/canonical.d.ts"
    },
    "./proof": {
      "import": "./dist/proof.js",
      "types": "./dist/proof.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --test-reporter=spec dist/tests/*.test.js",
    "example:verify": "node examples/verify_proof.mjs",
    "example:sign": "node examples/sign_value.mjs",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ophamin",
    "empirical-proof",
    "signed-record",
    "canonical-form",
    "hmac",
    "reproducibility"
  ],
  "license": "MIT",
  "author": "Idir Ben Slama",
  "homepage": "https://github.com/IdirBenSlama/Ophamin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IdirBenSlama/Ophamin.git",
    "directory": "packages/ophamin-proof-js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
