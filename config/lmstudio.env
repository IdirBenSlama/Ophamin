# Ophamin 0.63.1 agentic layer — LM Studio wiring.
#
# Usage:
#   1. Open LM Studio → load the 4 chat models below into memory.
#   2. Start LM Studio's "Local Server" tab (default port 1234).
#   3. `set -a; source config/lmstudio.env; set +a`
#   4. `ophamin agent brief <proof.json> --accept-reasoning`
#      (or any agent subcommand; only brief + triage need
#      --accept-reasoning if you route them to reasoning-tuned models).
#
# The OpenAI-compatible client at src/ophamin/agentic/client.py honors
# OPHAMIN_LLM_BASE_URL; the per-tier model strings below are consumed by
# src/ophamin/agentic/models.py's DEFAULT_TIER_MODELS env-override.
#
# Per-model channel audit (host-measured 2026-05-20 against /v1/models):
#
#   model                                | content      | reasoning_content | works as-is?
#   -------------------------------------|--------------|-------------------|---------------
#   google/gemma-4-26b-a4b               | empty        | populated         | needs --accept-reasoning
#   qwen/qwen3.5-35b-a3b                 | empty        | populated         | needs --accept-reasoning
#   qwen/qwen3-coder-next                | populated    | empty             | yes (default content channel)
#   openai/gpt-oss-120b                  | populated    | empty             | yes (default content channel)
#   text-embedding-nomic-embed-text-v1.5 | —            | —                 | embedding tier; reserved for 0.64.0
#
# Tier routing rationale:
# - FAST       → gpt-oss-120b      (content-clean; bundle_query needs strict JSON output)
# - WORKHORSE  → qwen3.5-35b-a3b   (reasoning-mode is FINE for brief; pair with --accept-reasoning)
# - CODER      → qwen3-coder-next  (code-specialized; content-clean)
# - REASONING  → gpt-oss-120b      (content-clean reasoner; triage needs strict JSON output)

OPHAMIN_LLM_BASE_URL=http://localhost:1234/v1

# LM Studio rejects response_format={"type":"json_object"} with HTTP 400.
# Use "text" instead (LM Studio accepts; relies on system-prompt for JSON).
# Values: json_object (default — OpenAI / Ollama / MLX-LM) | text | none.
OPHAMIN_LLM_JSON_FORMAT=text

# Per-tier model routing.
# NOTE: bundle_query (FAST) and refuted_triage (REASONING) need strict
# JSON output, so they go to content-clean models. proof_brief
# (WORKHORSE) tolerates reasoning-channel output with --accept-reasoning.
OPHAMIN_LLM_MODEL_FAST=openai/gpt-oss-120b
OPHAMIN_LLM_MODEL_WORKHORSE=qwen/qwen3.5-35b-a3b
OPHAMIN_LLM_MODEL_CODER=qwen/qwen3-coder-next
OPHAMIN_LLM_MODEL_REASONING=openai/gpt-oss-120b

# LM Studio doesn't require an API key by default; the client tolerates empty.
OPHAMIN_LLM_API_KEY=

# Optional alternative routings (uncomment to swap):
#
# To use Gemma 4 for fast routing (requires --accept-reasoning on brief):
#   OPHAMIN_LLM_MODEL_WORKHORSE=google/gemma-4-26b-a4b
#
# To use qwen3-coder-next for proof briefs (content-clean, no flag needed):
#   OPHAMIN_LLM_MODEL_WORKHORSE=qwen/qwen3-coder-next
#
# Audit signing key for LLMCallRecord. Override in deployment; default works.
# OPHAMIN_LLM_AUDIT_KEY=<32-byte hex>
