    "threshold": {
      "metric": "compatible_or_extends_count",
      "comparator": ">=",
      "value": 8.0,
      "units": "of_12"
    },
    "h0": "compatible_or_extends_count < 8 \u2014 Kimera's physics-named primitives mostly DON'T fit the SEED conservation framework; Pattern-P at the primitive-name level; conservation is local to (P + T + CW_seed) rather than substrate-wide",
    "h1": "compatible_or_extends_count >= 8 \u2014 substrate's physics-named primitives DO fit; physics-grade coherence is measurable at the conservation layer; Phase 5 of the Sinew campaign produces positive evidence"
  },
