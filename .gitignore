# Ophamin — generated artifacts and caches

# --- Python build / install ---
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/

# --- Virtualenvs ---
.venv/
venv/
env/
ENV/

# --- Test / typecheck caches ---
.pytest_cache/
.benchmarks/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- IDE / editor scratch ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Experiment outputs ---
# The manifest.json files inside runs/ ARE the provenance record; the heavy
# artifacts are content-addressed and excluded by default. Commit selectively.
runs/
mlruns/
data/raw/
data/processed/
*.pkl

# --- Verbose run logs ---
# Supplementary, NOT the canonical record. The signed, content-addressed
# Empirical Proof Records under proofs/ ARE the canonical evidence; logs/
# holds the full stdout/stderr per run for reproducibility but is gitignored
# because it can grow large.
logs/
pyphi.log
*.log

# --- Bench storage (pytest-benchmark output) ---
# Each run produces a JSON file under tests/bench/output or under
# bench_storage/. They're per-machine, per-build noise; the BASELINE
# numbers are pinned in docs/BENCHMARKS_AND_COVERAGE.md instead.
bench_storage/
tests/bench/output/
# A buggy bench-storage URI passed as a string sometimes lands as a
# literal "file:" directory; gitignore that shape too.
file:

# --- mkdocs build output (Phase L1) ---
# mkdocs writes the generated static site to `site/` by default.
# CI builds + deploys; we never commit the rendered HTML.
site/

# --- Local environment files ---
# Never commit secrets. PATs / API keys / OAuth tokens belong in env vars or
# secret managers, never in this tree.
.env
.env.*
!.env.example
secrets/
*.pem
*.key
